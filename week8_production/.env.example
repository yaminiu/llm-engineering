# Model Configuration
BASE_MODEL=meta-llama/Llama-3.2-3B
FINETUNED_MODEL=your-hf-username/price-model-name
MODEL_REVISION=main
HF_HUB_CACHE=/cache
HF_TOKEN=your_huggingface_token_here

# Model Parameters
DEVICE_MAP=auto
QUANTIZATION_ENABLED=true
MAX_NEW_TOKENS=5

# Service Configuration
MODAL_ENABLED=false
GPU_TYPE=T4
TIMEOUT_SECONDS=1800
MIN_CONTAINERS=0

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO

# Optional: UI Configuration
GRADIO_SHARE=false
GRADIO_INBROWSER=true

# Optional: Database Configuration
CHROMA_DB_PATH=./products_vectorstore
